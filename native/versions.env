# Pinned upstream versions for the MirrorBox native toolchain.
# Keep these in sync with native/README.md — CI caches keyed on this file.

QEMU_VERSION=11.1.0
QEMU_FALLBACK_VERSION=8.0.5

GLIB_VERSION=2.76.6
PCRE2_VERSION=10.42
LIBFFI_VERSION=3.4.4
ZLIB_VERSION=1.3.1
ZSTD_VERSION=1.5.6

E2FSPROGS_VERSION=1.47.1
DOSFSTOOLS_VERSION=4.2
MTOOLS_VERSION=4.0.43
NTFS3G_VERSION=2022.10.3
XORRISO_VERSION=1.5.6

# Minimum Android API level the tools are linked against.
ANDROID_API=24

# Upstream download locations (HTTPS).
QEMU_URL="https://download.qemu.org/qemu-${QEMU_VERSION}.tar.xz"
GLIB_URL="https://download.gnome.org/sources/glib/2.76/glib-${GLIB_VERSION}.tar.xz"
PCRE2_URL="https://github.com/PCRE2Project/pcre2/releases/download/pcre2-${PCRE2_VERSION}/pcre2-${PCRE2_VERSION}.tar.gz"
LIBFFI_URL="https://github.com/libffi/libffi/releases/download/v${LIBFFI_VERSION}/libffi-${LIBFFI_VERSION}.tar.gz"
ZLIB_URL="https://zlib.net/fossils/zlib-${ZLIB_VERSION}.tar.gz"
ZSTD_URL="https://github.com/facebook/zstd/releases/download/v${ZSTD_VERSION}/zstd-${ZSTD_VERSION}.tar.gz"
E2FSPROGS_URL="https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v${E2FSPROGS_VERSION}/e2fsprogs-${E2FSPROGS_VERSION}.tar.xz"
DOSFSTOOLS_URL="https://github.com/dosfstools/dosfstools/releases/download/v${DOSFSTOOLS_VERSION}/dosfstools-${DOSFSTOOLS_VERSION}.tar.gz"
MTOOLS_URL="https://ftp.gnu.org/gnu/mtools/mtools-${MTOOLS_VERSION}.tar.gz"
NTFS3G_URL="https://tuxera.com/opensource/ntfs-3g_ntfsprogs-${NTFS3G_VERSION}.tgz"
XORRISO_URL="https://ftp.gnu.org/gnu/xorriso/xorriso-${XORRISO_VERSION}.tar.gz"
